<Window x:Class="MdbReadTest.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MDB 只读测试 · .NET Framework 4.8 · 32位" Width="1100" Height="650"
 MinWidth="750" MinHeight="400" Topmost="True" WindowStartupLocation="CenterScreen">
 <Grid Margin="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10">
   <TextBlock Text="检测目录：" VerticalAlignment="Center"/>
   <TextBox x:Name="DirectoryBox" Text="D:\齿轮双面啮合仪检测系统\统计" Padding="6"/>
  </DockPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
   <TextBlock Text="读取驱动：" VerticalAlignment="Center"/>
   <ComboBox x:Name="ProviderBox" Width="260" SelectedIndex="0">
    <ComboBoxItem Content="自动选择已安装驱动"/>
    <ComboBoxItem Content="Microsoft.ACE.OLEDB.12.0"/>
    <ComboBoxItem Content="Microsoft.ACE.OLEDB.16.0"/>
    <ComboBoxItem Content="Microsoft.Jet.OLEDB.4.0"/>
   </ComboBox>
   <Button x:Name="ReadButton" Content="读取最新 MDB" Click="ReadClick" Padding="14,5" Margin="12,0"/>
   <CheckBox x:Name="AutoBox" Content="每 2 秒刷新" IsChecked="True" VerticalAlignment="Center"/>
  </StackPanel>
  <TextBox Grid.Row="2" x:Name="FileText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Margin="0,0,0,8"/>
  <TextBox Grid.Row="3" x:Name="StatusText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Foreground="DarkSlateGray" Margin="0,0,0,10" MaxHeight="130" VerticalScrollBarVisibility="Auto"/>
  <TabControl Grid.Row="4" x:Name="TablesTabs"/>
 </Grid>
</Window>
