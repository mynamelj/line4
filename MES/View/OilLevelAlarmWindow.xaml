<Window x:Class="MES.View.OilLevelAlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="油位报警"
        Width="420"
        Height="240"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="油位低"
                   FontSize="36"
                   FontWeight="Bold"
                   Foreground="Red"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <Button Grid.Row="1"
                Content="关闭"
                Width="100"
                Height="36"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Click="CloseButton_Click" />
    </Grid>
</Window>
