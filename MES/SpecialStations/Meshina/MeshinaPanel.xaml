<UserControl x:Class="MES.SpecialStations.Meshina.MeshinaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="#B8CDD8" BorderThickness="1" Background="#F0F7FA" Padding="10" Margin="5">
        <StackPanel>
            <TextBlock x:Name="StationTitle" Text="线外啮合" FontSize="18" FontWeight="Bold" />
            <StackPanel x:Name="UsbScanPanel">
                <TextBlock Text="USB扫码输入（扫码枪以回车或Tab结束）" Margin="0,6,0,3" />
                <TextBox x:Name="UsbScanInput" FontSize="18" Padding="5" MinHeight="32"
                         InputMethod.IsInputMethodEnabled="False" AcceptsReturn="False" AcceptsTab="False"
                         PreviewKeyDown="UsbScanInput_PreviewKeyDown" />
            </StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="16" Margin="0,5" />
            <TextBlock x:Name="JobText" TextWrapping="Wrap" />
            <WrapPanel Margin="0,5,0,0">
                <Button x:Name="RetryButton" Content="重试原任务" Click="RetryClick" Padding="10,5" Margin="0,0,8,0" />
                <Button x:Name="AbortButton" Content="终止本次流程" Click="AbortClick" Padding="10,5" />
                <Button x:Name="TestMdbButton" Content="生成测试MDB" Click="TestMdbClick"
                        Padding="10,5" Margin="8,0,0,0" />
            </WrapPanel>
            <TextBlock Text="扫码 → FeedingCheck成功后啮合 → 等待自动出站成功 → 扫下一件。MES失败后可重试原任务。"
                       TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#456070" />
        </StackPanel>
    </Border>
</UserControl>
